<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiNativeStyle.Pages.InputsPage"
             Title="Inputs"
             StyleClass="Grouped">
    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="0,8,0,24">

            <Label Text="Search" Style="{StaticResource SectionHeader}" />
            <SearchBar Placeholder="Search" Margin="8,0" />

            <Label Text="Text fields" Style="{StaticResource SectionHeader}" />
            <VerticalStackLayout Spacing="12" Padding="16,0">
                <Entry Placeholder="Name" />
                <Entry Placeholder="Email" Keyboard="Email" />
                <Entry Placeholder="Password" IsPassword="True" />
                <Entry Placeholder="Disabled" IsEnabled="False" />
            </VerticalStackLayout>

            <Label Text="Grouped form" Style="{StaticResource SectionHeader}" />
            <Border StyleClass="GroupedCell">
                <VerticalStackLayout>
                    <Grid StyleClass="ListRow" ColumnDefinitions="90,*">
                        <Label Text="First name" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Placeholder="Required" StyleClass="Plain" />
                    </Grid>
                    <BoxView StyleClass="Separator" />
                    <Grid StyleClass="ListRow" ColumnDefinitions="90,*">
                        <Label Text="Last name" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Placeholder="Required" StyleClass="Plain" />
                    </Grid>
                    <BoxView StyleClass="Separator" />
                    <Grid StyleClass="ListRow" ColumnDefinitions="90,*">
                        <Label Text="Phone" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Placeholder="Optional" Keyboard="Telephone" StyleClass="Plain" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Label Text="Entries inside a grouped cell use the Plain class (no border on iOS)." Style="{StaticResource SectionFooter}" />

            <Label Text="Multiline" Style="{StaticResource SectionHeader}" />
            <VerticalStackLayout Padding="16,0">
                <Editor Placeholder="Notes" />
            </VerticalStackLayout>

            <Label Text="Pickers" Style="{StaticResource SectionHeader}" />
            <Border StyleClass="GroupedCell">
                <VerticalStackLayout>
                    <Grid StyleClass="ListRow" ColumnDefinitions="*,Auto">
                        <Label Text="Language" VerticalOptions="Center" />
                        <Picker Grid.Column="1" Title="Choose" SelectedIndex="0">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>English</x:String>
                                    <x:String>Italiano</x:String>
                                    <x:String>Deutsch</x:String>
                                    <x:String>Français</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Grid>
                    <BoxView StyleClass="Separator" />
                    <Grid StyleClass="ListRow" ColumnDefinitions="*,Auto">
                        <Label Text="Date" VerticalOptions="Center" />
                        <DatePicker Grid.Column="1" />
                    </Grid>
                    <BoxView StyleClass="Separator" />
                    <Grid StyleClass="ListRow" ColumnDefinitions="*,Auto">
                        <Label Text="Time" VerticalOptions="Center" />
                        <TimePicker Grid.Column="1" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

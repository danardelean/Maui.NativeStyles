<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="MauiNativeStyle.Resources.Styles.Android.MaterialColors">

    <!--
        Material 3 baseline color roles (seed #6750A4), from the md-sys-color / md-ref-palette tokens.
        Keys without suffix = light scheme, "Dark" suffix = dark scheme.
        Note: on Android 12+ the system may apply dynamic colors (Material You) to native widgets;
        these static roles are what XAML-painted surfaces use.
    -->

    <Color x:Key="Primary">#6750A4</Color>
    <Color x:Key="PrimaryDark">#D0BCFF</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="OnPrimaryDark">#381E72</Color>
    <Color x:Key="PrimaryContainer">#EADDFF</Color>
    <Color x:Key="PrimaryContainerDark">#4F378B</Color>
    <Color x:Key="OnPrimaryContainer">#21005D</Color>
    <Color x:Key="OnPrimaryContainerDark">#EADDFF</Color>

    <Color x:Key="Secondary">#625B71</Color>
    <Color x:Key="SecondaryDark">#CCC2DC</Color>
    <Color x:Key="OnSecondary">#FFFFFF</Color>
    <Color x:Key="OnSecondaryDark">#332D41</Color>
    <Color x:Key="SecondaryContainer">#E8DEF8</Color>
    <Color x:Key="SecondaryContainerDark">#4A4458</Color>
    <Color x:Key="OnSecondaryContainer">#1D192B</Color>
    <Color x:Key="OnSecondaryContainerDark">#E8DEF8</Color>

    <Color x:Key="Tertiary">#7D5260</Color>
    <Color x:Key="TertiaryDark">#EFB8C8</Color>
    <Color x:Key="OnTertiary">#FFFFFF</Color>
    <Color x:Key="OnTertiaryDark">#492532</Color>
    <Color x:Key="TertiaryContainer">#FFD8E4</Color>
    <Color x:Key="TertiaryContainerDark">#633B48</Color>
    <Color x:Key="OnTertiaryContainer">#31111D</Color>
    <Color x:Key="OnTertiaryContainerDark">#FFD8E4</Color>

    <Color x:Key="Error">#B3261E</Color>
    <Color x:Key="ErrorDark">#F2B8B5</Color>
    <Color x:Key="OnError">#FFFFFF</Color>
    <Color x:Key="OnErrorDark">#601410</Color>
    <Color x:Key="ErrorContainer">#F9DEDC</Color>
    <Color x:Key="ErrorContainerDark">#8C1D18</Color>
    <Color x:Key="OnErrorContainer">#410E0B</Color>
    <Color x:Key="OnErrorContainerDark">#F9DEDC</Color>

    <Color x:Key="Surface">#FEF7FF</Color>
    <Color x:Key="SurfaceDark">#141218</Color>
    <Color x:Key="OnSurface">#1D1B20</Color>
    <Color x:Key="OnSurfaceDark">#E6E0E9</Color>
    <Color x:Key="SurfaceVariant">#E7E0EC</Color>
    <Color x:Key="SurfaceVariantDark">#49454F</Color>
    <Color x:Key="OnSurfaceVariant">#49454F</Color>
    <Color x:Key="OnSurfaceVariantDark">#CAC4D0</Color>
    <Color x:Key="SurfaceDim">#DED8E1</Color>
    <Color x:Key="SurfaceDimDark">#141218</Color>
    <Color x:Key="SurfaceBright">#FEF7FF</Color>
    <Color x:Key="SurfaceBrightDark">#3B383E</Color>
    <Color x:Key="SurfaceContainerLowest">#FFFFFF</Color>
    <Color x:Key="SurfaceContainerLowestDark">#0F0D13</Color>
    <Color x:Key="SurfaceContainerLow">#F7F2FA</Color>
    <Color x:Key="SurfaceContainerLowDark">#1D1B20</Color>
    <Color x:Key="SurfaceContainer">#F3EDF7</Color>
    <Color x:Key="SurfaceContainerDark">#211F26</Color>
    <Color x:Key="SurfaceContainerHigh">#ECE6F0</Color>
    <Color x:Key="SurfaceContainerHighDark">#2B2930</Color>
    <Color x:Key="SurfaceContainerHighest">#E6E0E9</Color>
    <Color x:Key="SurfaceContainerHighestDark">#36343B</Color>

    <Color x:Key="Outline">#79747E</Color>
    <Color x:Key="OutlineDark">#938F99</Color>
    <Color x:Key="OutlineVariant">#CAC4D0</Color>
    <Color x:Key="OutlineVariantDark">#49454F</Color>

    <Color x:Key="InverseSurface">#322F35</Color>
    <Color x:Key="InverseSurfaceDark">#E6E0E9</Color>
    <Color x:Key="InverseOnSurface">#F5EFF7</Color>
    <Color x:Key="InverseOnSurfaceDark">#322F35</Color>
    <Color x:Key="InversePrimary">#D0BCFF</Color>
    <Color x:Key="InversePrimaryDark">#6750A4</Color>
    <Color x:Key="Scrim">#000000</Color>
    <Color x:Key="ScrimDark">#000000</Color>

    <!-- State layers: onSurface at 12% (disabled container) and 38% (disabled content) -->
    <Color x:Key="DisabledContainer">#1F1D1B20</Color>
    <Color x:Key="DisabledContainerDark">#1FE6E0E9</Color>
    <Color x:Key="DisabledContent">#611D1B20</Color>
    <Color x:Key="DisabledContentDark">#61E6E0E9</Color>
    <Color x:Key="PressedStateLayer">#1F1D1B20</Color>
    <Color x:Key="PressedStateLayerDark">#1FE6E0E9</Color>

    <!-- Theme-aware brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
    <SolidColorBrush x:Key="OutlineBrush" Color="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}" />
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark={StaticResource SurfaceContainerLowDark}}" />
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="{AppThemeBinding Light={StaticResource SurfaceContainerHighest}, Dark={StaticResource SurfaceContainerHighestDark}}" />

    <!-- Cross-platform semantic aliases (same keys exist in iOSColors.xaml) -->
    <Color x:Key="AccentColor">#6750A4</Color>
    <Color x:Key="AccentColorDark">#D0BCFF</Color>
    <Color x:Key="DestructiveColor">#B3261E</Color>
    <Color x:Key="DestructiveColorDark">#F2B8B5</Color>
    <Color x:Key="TextPrimary">#1D1B20</Color>
    <Color x:Key="TextPrimaryDark">#E6E0E9</Color>
    <Color x:Key="TextSecondary">#49454F</Color>
    <Color x:Key="TextSecondaryDark">#CAC4D0</Color>
    <Color x:Key="PageBackground">#FEF7FF</Color>
    <Color x:Key="PageBackgroundDark">#141218</Color>
    <Color x:Key="GroupedPageBackground">#FEF7FF</Color>
    <Color x:Key="GroupedPageBackgroundDark">#141218</Color>
    <Color x:Key="CardBackground">#F7F2FA</Color>
    <Color x:Key="CardBackgroundDark">#1D1B20</Color>
    <Color x:Key="DividerColor">#CAC4D0</Color>
    <Color x:Key="DividerColorDark">#49454F</Color>

</ResourceDictionary>

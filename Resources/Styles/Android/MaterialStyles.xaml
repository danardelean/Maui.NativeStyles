<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:android="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.AndroidSpecific;assembly=Microsoft.Maui.Controls"
                    xmlns:native="clr-namespace:MauiNativeStyle.NativeStyles"
                    x:Class="MauiNativeStyle.Resources.Styles.Android.MaterialStyles">

    <!--
        Material 3 implicit styles. Requires <UseMaterial3>true</UseMaterial3> (Microsoft.Maui.Controls >= 10.0.60):
        Entry/Editor -> TextInputLayout, Switch -> MaterialSwitch, Slider -> Material Slider,
        ProgressBar -> LinearProgressIndicator, pickers -> Material dialogs.
        Rule: never set FontFamily (Roboto), never paint BackgroundColor on input controls,
        never override Switch/Slider/CheckBox/ProgressBar colors: the M3 theme owns them.
        Button variants via StyleClass: Filled (default), Tonal, Outlined, Text, Glass (= Elevated),
        GlassProminent (= Filled), Destructive, Small, Large.
    -->

    <!-- Text -->
    <Style TargetType="Label" BasedOn="{StaticResource BodyLarge}" />
    <Style TargetType="Label" Class="Secondary">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>
    <Style TargetType="Label" Class="Tertiary">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}" />
    </Style>
    <Style TargetType="Label" Class="Accent">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
    </Style>
    <Style TargetType="Label" Class="Semibold">
        <Setter Property="FontFamily" Value="sans-serif-medium" />
    </Style>
    <Style TargetType="Span">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
    </Style>

    <!-- Button: M3 common button, 40dp, pill (corner radius left to the M3 default), Label Large -->
    <Style TargetType="Button">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="sans-serif-medium" />
        <Setter Property="CharacterSpacing" Value="0.1" />
        <Setter Property="Padding" Value="24,8" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DisabledContent}, Dark={StaticResource DisabledContentDark}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DisabledContainer}, Dark={StaticResource DisabledContainerDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style TargetType="Button" Class="Tonal">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource OnSecondaryContainerDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SecondaryContainer}, Dark={StaticResource SecondaryContainerDark}}" />
    </Style>
    <Style TargetType="Button" Class="Outlined">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>
    <Style TargetType="Button" Class="Text">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style TargetType="Button" Class="Glass">
        <!-- M3 elevated button -->
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark={StaticResource SurfaceContainerLowDark}}" />
        <Setter Property="android:Button.UseDefaultShadow" Value="True" />
    </Style>
    <Style TargetType="Button" Class="GlassProminent" />
    <Style TargetType="Button" Class="Destructive">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnError}, Dark={StaticResource OnErrorDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
    </Style>
    <Style TargetType="Button" Class="Small">
        <!-- M3 Expressive extra-small -->
        <Setter Property="MinimumHeightRequest" Value="32" />
        <Setter Property="Padding" Value="16,4" />
    </Style>
    <Style TargetType="Button" Class="Large">
        <!-- M3 Expressive medium -->
        <Setter Property="MinimumHeightRequest" Value="56" />
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style TargetType="ImageButton">
        <!-- M3 standard icon button: 40dp, 24dp icon -->
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="MinimumWidthRequest" Value="40" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.38" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Text input: TextInputLayout (outlined) from the M3 theme; only typography and text colors -->
    <Style TargetType="Entry">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>
    <Style TargetType="Entry" Class="Plain" />
    <Style TargetType="Editor">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
        <Setter Property="AutoSize" Value="TextChanges" />
        <Setter Property="MinimumHeightRequest" Value="96" />
    </Style>
    <Style TargetType="SearchBar">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>

    <!-- Pickers: Material dialogs from the M3 theme -->
    <Style TargetType="Picker">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
    </Style>
    <Style TargetType="TimePicker">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
    </Style>

    <!-- Selection: Switch / Slider / CheckBox / Stepper intentionally have NO style (M3 widgets) -->
    <Style TargetType="RadioButton">
        <!-- No ControlTemplate: keeps the native MaterialRadioButton -->
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <!-- Feedback: ProgressBar / ActivityIndicator intentionally have NO style -->

    <!-- Containers -->
    <Style TargetType="Border">
        <!-- M3 elevated card: surfaceContainerLow, 12dp corners, elevation 1 -->
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark={StaticResource SurfaceContainerLowDark}}" />
        <Setter Property="Shadow">
            <Shadow Brush="Black" Opacity="0.18" Radius="3" Offset="0,1" />
        </Setter>
    </Style>
    <Style TargetType="Border" Class="Card">
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style TargetType="Border" Class="GroupedCell">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="16,0" />
    </Style>
    <Style TargetType="Border" Class="Outlined">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{StaticResource OutlineVariantBrush}" />
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Shadow" Value="{x:Null}" />
    </Style>
    <Style TargetType="Border" Class="Filled">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource SurfaceContainerHighest}, Dark={StaticResource SurfaceContainerHighestDark}}" />
        <Setter Property="Shadow" Value="{x:Null}" />
    </Style>

    <!-- List item: 56dp one-line / 72dp two-line, 16dp padding, state layer on selection -->
    <Style TargetType="Grid" Class="ListRow">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinimumHeightRequest" Value="56" />
        <Setter Property="ColumnSpacing" Value="16" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PressedStateLayer}, Dark={StaticResource PressedStateLayerDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style TargetType="BoxView" Class="Separator">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>
    <Style TargetType="Label" Class="Chevron">
        <!-- Material lists do not use disclosure chevrons -->
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
    </Style>
    <Style TargetType="ContentPage" Class="Grouped" ApplyToDerivedTypes="True" />
    <Style TargetType="ScrollView">
        <Setter Property="Padding" Value="0,0,0,16" />
    </Style>

    <!-- Shell: M3 top app bar (surface, onSurface title, no shadow) and navigation bar (surfaceContainer) -->
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource DisabledContent}, Dark={StaticResource DisabledContentDark}}" />
        <Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceContainer}, Dark={StaticResource SurfaceContainerDark}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource OnSecondaryContainerDark}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>
    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
    </Style>

    <!-- GlassView on Android = M3 elevated card (rounded background + elevation from the handler) -->
    <Style TargetType="native:GlassView">
        <Setter Property="Padding" Value="8" />
    </Style>

</ResourceDictionary>

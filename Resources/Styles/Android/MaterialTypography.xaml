<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="MauiNativeStyle.Resources.Styles.Android.MaterialTypography">

    <!--
        Material 3 type scale (md.sys.typescale tokens). Sizes in sp (MAUI units map 1:1 on Android).
        FontFamily is never set for weight 400 (Roboto via the handler default);
        "sans-serif-medium" gives Roboto Medium (weight 500) for Title M/S and Label styles.
    -->

    <Style x:Key="BaseText" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="DisplayLarge" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="57" />
        <Setter Property="CharacterSpacing" Value="-0.25" />
    </Style>
    <Style x:Key="DisplayMedium" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="45" />
    </Style>
    <Style x:Key="DisplaySmall" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="36" />
    </Style>
    <Style x:Key="HeadlineLarge" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="32" />
    </Style>
    <Style x:Key="HeadlineMedium" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="28" />
    </Style>
    <Style x:Key="HeadlineSmall" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="24" />
    </Style>
    <Style x:Key="TitleLarge" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="22" />
    </Style>
    <Style x:Key="TitleMedium" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="sans-serif-medium" />
        <Setter Property="CharacterSpacing" Value="0.15" />
    </Style>
    <Style x:Key="TitleSmall" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="sans-serif-medium" />
        <Setter Property="CharacterSpacing" Value="0.1" />
    </Style>
    <Style x:Key="BodyLarge" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CharacterSpacing" Value="0.5" />
    </Style>
    <Style x:Key="BodyMedium" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CharacterSpacing" Value="0.25" />
    </Style>
    <Style x:Key="BodySmall" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="0.4" />
    </Style>
    <Style x:Key="LabelLarge" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="sans-serif-medium" />
        <Setter Property="CharacterSpacing" Value="0.1" />
    </Style>
    <Style x:Key="LabelMedium" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="sans-serif-medium" />
        <Setter Property="CharacterSpacing" Value="0.5" />
    </Style>
    <Style x:Key="LabelSmall" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="sans-serif-medium" />
        <Setter Property="CharacterSpacing" Value="0.5" />
    </Style>

    <!-- List subheader: Title Small, primary color, 16dp padding -->
    <Style x:Key="SectionHeader" TargetType="Label" BasedOn="{StaticResource TitleSmall}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="Margin" Value="16,16,16,8" />
    </Style>
    <Style x:Key="SectionFooter" TargetType="Label" BasedOn="{StaticResource BodySmall}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
        <Setter Property="Margin" Value="16,8,16,16" />
    </Style>

    <!-- Cross-platform aliases (same keys exist in iOSTypography.xaml) -->
    <Style x:Key="TitleXL" TargetType="Label" BasedOn="{StaticResource HeadlineLarge}" />
    <Style x:Key="TitleL" TargetType="Label" BasedOn="{StaticResource HeadlineMedium}" />
    <Style x:Key="TitleM" TargetType="Label" BasedOn="{StaticResource HeadlineSmall}" />
    <Style x:Key="TitleS" TargetType="Label" BasedOn="{StaticResource TitleLarge}" />
    <Style x:Key="Headline" TargetType="Label" BasedOn="{StaticResource TitleMedium}" />
    <Style x:Key="BodyEmphasized" TargetType="Label" BasedOn="{StaticResource TitleMedium}" />
    <Style x:Key="Body" TargetType="Label" BasedOn="{StaticResource BodyLarge}" />
    <Style x:Key="BodySecondary" TargetType="Label" BasedOn="{StaticResource BodyMedium}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>
    <Style x:Key="Caption" TargetType="Label" BasedOn="{StaticResource BodySmall}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>

</ResourceDictionary>

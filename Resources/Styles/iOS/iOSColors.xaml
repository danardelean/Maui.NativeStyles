<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="MauiNativeStyle.Resources.Styles.iOS.iOSColors">

    <!--
        iOS 26 system colors (Apple HIG > Color, values updated June 2025).
        Keys without suffix = light appearance, "Dark" suffix = dark appearance.
        Use them through AppThemeBinding: {AppThemeBinding Light={StaticResource SystemBlue}, Dark={StaticResource SystemBlueDark}}
    -->

    <!-- Tint colors -->
    <Color x:Key="SystemBlue">#0088FF</Color>
    <Color x:Key="SystemBlueDark">#0091FF</Color>
    <Color x:Key="SystemRed">#FF383C</Color>
    <Color x:Key="SystemRedDark">#FF4245</Color>
    <Color x:Key="SystemOrange">#FF8D28</Color>
    <Color x:Key="SystemOrangeDark">#FF9230</Color>
    <Color x:Key="SystemYellow">#FFCC00</Color>
    <Color x:Key="SystemYellowDark">#FFD600</Color>
    <Color x:Key="SystemGreen">#34C759</Color>
    <Color x:Key="SystemGreenDark">#30D158</Color>
    <Color x:Key="SystemMint">#00C8B3</Color>
    <Color x:Key="SystemMintDark">#00DAC3</Color>
    <Color x:Key="SystemTeal">#00C3D0</Color>
    <Color x:Key="SystemTealDark">#00D2E0</Color>
    <Color x:Key="SystemCyan">#00C0E8</Color>
    <Color x:Key="SystemCyanDark">#3CD3FE</Color>
    <Color x:Key="SystemIndigo">#6155F5</Color>
    <Color x:Key="SystemIndigoDark">#6D7CFF</Color>
    <Color x:Key="SystemPurple">#CB30E0</Color>
    <Color x:Key="SystemPurpleDark">#DB34F2</Color>
    <Color x:Key="SystemPink">#FF2D55</Color>
    <Color x:Key="SystemPinkDark">#FF375F</Color>
    <Color x:Key="SystemBrown">#AC7F5E</Color>
    <Color x:Key="SystemBrownDark">#B78A66</Color>

    <!-- Gray palette (unchanged since iOS 13) -->
    <Color x:Key="SystemGray">#8E8E93</Color>
    <Color x:Key="SystemGrayDark">#8E8E93</Color>
    <Color x:Key="SystemGray2">#AEAEB2</Color>
    <Color x:Key="SystemGray2Dark">#636366</Color>
    <Color x:Key="SystemGray3">#C7C7CC</Color>
    <Color x:Key="SystemGray3Dark">#48484A</Color>
    <Color x:Key="SystemGray4">#D1D1D6</Color>
    <Color x:Key="SystemGray4Dark">#3A3A3C</Color>
    <Color x:Key="SystemGray5">#E5E5EA</Color>
    <Color x:Key="SystemGray5Dark">#2C2C2E</Color>
    <Color x:Key="SystemGray6">#F2F2F7</Color>
    <Color x:Key="SystemGray6Dark">#1C1C1E</Color>

    <!-- Label colors (alpha-composited, #AARRGGBB) -->
    <Color x:Key="LabelColor">#000000</Color>
    <Color x:Key="LabelColorDark">#FFFFFF</Color>
    <Color x:Key="SecondaryLabelColor">#993C3C43</Color>
    <Color x:Key="SecondaryLabelColorDark">#99EBEBF5</Color>
    <Color x:Key="TertiaryLabelColor">#4D3C3C43</Color>
    <Color x:Key="TertiaryLabelColorDark">#4DEBEBF5</Color>
    <Color x:Key="QuaternaryLabelColor">#2E3C3C43</Color>
    <Color x:Key="QuaternaryLabelColorDark">#2EEBEBF5</Color>
    <Color x:Key="PlaceholderTextColor">#4D3C3C43</Color>
    <Color x:Key="PlaceholderTextColorDark">#4DEBEBF5</Color>
    <Color x:Key="LinkColor">#007AFF</Color>
    <Color x:Key="LinkColorDark">#0984FF</Color>

    <!-- Separators -->
    <Color x:Key="SeparatorColor">#4A3C3C43</Color>
    <Color x:Key="SeparatorColorDark">#99545458</Color>
    <Color x:Key="OpaqueSeparatorColor">#C6C6C8</Color>
    <Color x:Key="OpaqueSeparatorColorDark">#38383A</Color>

    <!-- Fills -->
    <Color x:Key="SystemFill">#33787880</Color>
    <Color x:Key="SystemFillDark">#5C787880</Color>
    <Color x:Key="SecondarySystemFill">#29787880</Color>
    <Color x:Key="SecondarySystemFillDark">#52787880</Color>
    <Color x:Key="TertiarySystemFill">#1F767680</Color>
    <Color x:Key="TertiarySystemFillDark">#3D767680</Color>
    <Color x:Key="QuaternarySystemFill">#14747480</Color>
    <Color x:Key="QuaternarySystemFillDark">#2E767680</Color>

    <!-- Backgrounds -->
    <Color x:Key="SystemBackground">#FFFFFF</Color>
    <Color x:Key="SystemBackgroundDark">#000000</Color>
    <Color x:Key="SecondarySystemBackground">#F2F2F7</Color>
    <Color x:Key="SecondarySystemBackgroundDark">#1C1C1E</Color>
    <Color x:Key="TertiarySystemBackground">#FFFFFF</Color>
    <Color x:Key="TertiarySystemBackgroundDark">#2C2C2E</Color>
    <Color x:Key="SystemGroupedBackground">#F2F2F7</Color>
    <Color x:Key="SystemGroupedBackgroundDark">#000000</Color>
    <Color x:Key="SecondarySystemGroupedBackground">#FFFFFF</Color>
    <Color x:Key="SecondarySystemGroupedBackgroundDark">#1C1C1E</Color>
    <Color x:Key="TertiarySystemGroupedBackground">#F2F2F7</Color>
    <Color x:Key="TertiarySystemGroupedBackgroundDark">#2C2C2E</Color>

    <!-- Theme-aware brushes for Background / Stroke properties -->
    <SolidColorBrush x:Key="SystemBlueBrush" Color="{AppThemeBinding Light={StaticResource SystemBlue}, Dark={StaticResource SystemBlueDark}}" />
    <SolidColorBrush x:Key="SystemRedBrush" Color="{AppThemeBinding Light={StaticResource SystemRed}, Dark={StaticResource SystemRedDark}}" />
    <SolidColorBrush x:Key="SystemGreenBrush" Color="{AppThemeBinding Light={StaticResource SystemGreen}, Dark={StaticResource SystemGreenDark}}" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="{AppThemeBinding Light={StaticResource SeparatorColor}, Dark={StaticResource SeparatorColorDark}}" />
    <SolidColorBrush x:Key="SystemFillBrush" Color="{AppThemeBinding Light={StaticResource SystemFill}, Dark={StaticResource SystemFillDark}}" />
    <SolidColorBrush x:Key="TertiarySystemFillBrush" Color="{AppThemeBinding Light={StaticResource TertiarySystemFill}, Dark={StaticResource TertiarySystemFillDark}}" />
    <SolidColorBrush x:Key="SystemBackgroundBrush" Color="{AppThemeBinding Light={StaticResource SystemBackground}, Dark={StaticResource SystemBackgroundDark}}" />
    <SolidColorBrush x:Key="SecondarySystemBackgroundBrush" Color="{AppThemeBinding Light={StaticResource SecondarySystemBackground}, Dark={StaticResource SecondarySystemBackgroundDark}}" />
    <SolidColorBrush x:Key="SystemGroupedBackgroundBrush" Color="{AppThemeBinding Light={StaticResource SystemGroupedBackground}, Dark={StaticResource SystemGroupedBackgroundDark}}" />
    <SolidColorBrush x:Key="SecondarySystemGroupedBackgroundBrush" Color="{AppThemeBinding Light={StaticResource SecondarySystemGroupedBackground}, Dark={StaticResource SecondarySystemGroupedBackgroundDark}}" />

    <!-- Cross-platform semantic aliases (same keys exist in MaterialColors.xaml) -->
    <Color x:Key="AccentColor">#0088FF</Color>
    <Color x:Key="AccentColorDark">#0091FF</Color>
    <Color x:Key="DestructiveColor">#FF383C</Color>
    <Color x:Key="DestructiveColorDark">#FF4245</Color>
    <Color x:Key="TextPrimary">#000000</Color>
    <Color x:Key="TextPrimaryDark">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#993C3C43</Color>
    <Color x:Key="TextSecondaryDark">#99EBEBF5</Color>
    <Color x:Key="PageBackground">#FFFFFF</Color>
    <Color x:Key="PageBackgroundDark">#000000</Color>
    <Color x:Key="GroupedPageBackground">#F2F2F7</Color>
    <Color x:Key="GroupedPageBackgroundDark">#000000</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="CardBackgroundDark">#1C1C1E</Color>
    <Color x:Key="DividerColor">#4A3C3C43</Color>
    <Color x:Key="DividerColorDark">#99545458</Color>

</ResourceDictionary>

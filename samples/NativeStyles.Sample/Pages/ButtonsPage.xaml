<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:native="clr-namespace:NativeStyles;assembly=Maui.NativeStyles"
             x:Class="NativeStyles.Sample.Pages.ButtonsPage"
             Title="Buttons"
             StyleClass="Grouped">
    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,0,0,24">

            <Label Text="Roles" Style="{StaticResource SectionHeader}" />
            <VerticalStackLayout Spacing="12" Padding="{StaticResource ContentMargin}">
                <Button Text="Default (plain / filled)" />
                <Button Text="Filled" StyleClass="Filled" />
                <Button Text="Tonal / Tinted" StyleClass="Tonal" />
                <Button Text="Outlined / Gray" StyleClass="Outlined" />
                <Button Text="Text / Plain" StyleClass="Text" />
                <Button Text="Elevated / Glass" StyleClass="Glass" />
                <Button Text="Glass Prominent" StyleClass="GlassProminent" />
            </VerticalStackLayout>

            <Label Text="Destructive" Style="{StaticResource SectionHeader}" />
            <VerticalStackLayout Spacing="12" Padding="{StaticResource ContentMargin}">
                <Button Text="Delete account" StyleClass="Filled, Destructive" />
                <Button Text="Remove" StyleClass="Text, Destructive" />
            </VerticalStackLayout>

            <Label Text="Sizes" Style="{StaticResource SectionHeader}" />
            <HorizontalStackLayout Spacing="12" Padding="{StaticResource ContentMargin}">
                <Button Text="Small" StyleClass="Filled, Small" VerticalOptions="Center" />
                <Button Text="Default" StyleClass="Filled" VerticalOptions="Center" />
                <Button Text="Large" StyleClass="Filled, Large" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="States" Style="{StaticResource SectionHeader}" />
            <VerticalStackLayout Spacing="12" Padding="{StaticResource ContentMargin}">
                <Button Text="Disabled filled" StyleClass="Filled" IsEnabled="False" />
                <Button Text="Disabled plain" IsEnabled="False" />
                <Button Text="With icon" StyleClass="Tonal" ImageSource="tab_feedback.svg" />
            </VerticalStackLayout>

            <Label Text="Floating over content (Liquid Glass)" Style="{StaticResource SectionHeader}" />
            <Grid Margin="{StaticResource ContentMargin}" HeightRequest="240">
                <Border Padding="0">
                    <Image Source="dotnet_bot.png" Aspect="AspectFill" />
                </Border>
                <native:GlassView HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,16">
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Share" StyleClass="Glass" />
                        <Button Text="Continue" StyleClass="GlassProminent" />
                    </HorizontalStackLayout>
                </native:GlassView>
            </Grid>
            <Label Text="On iOS 26 the container uses UIGlassEffect; on iOS 15–18 a system-material blur; on Android an elevated Material surface."
                   Style="{StaticResource SectionFooter}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

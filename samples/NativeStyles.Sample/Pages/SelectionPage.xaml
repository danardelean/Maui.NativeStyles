<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:native="clr-namespace:NativeStyles;assembly=Maui.NativeStyles"
             x:Class="NativeStyles.Sample.Pages.SelectionPage"
             Title="Selection"
             StyleClass="Grouped">
    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,0,0,24">

            <Label Text="Segmented choice" Style="{StaticResource SectionHeader}" />
            <native:SegmentedControl Margin="{StaticResource ContentMargin}" SelectedIndex="1">
                <x:String>Day</x:String>
                <x:String>Week</x:String>
                <x:String>Month</x:String>
            </native:SegmentedControl>

            <Label Text="Toggles" Style="{StaticResource SectionHeader}" />
            <Border StyleClass="GroupedCell">
                <VerticalStackLayout>
                    <Grid StyleClass="ListRow" ColumnDefinitions="*,Auto">
                        <Label Text="Airplane mode" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="True" VerticalOptions="Center" />
                    </Grid>
                    <BoxView StyleClass="Separator" />
                    <Grid StyleClass="ListRow" ColumnDefinitions="*,Auto">
                        <Label Text="Wi-Fi" VerticalOptions="Center" />
                        <Switch Grid.Column="1" VerticalOptions="Center" />
                    </Grid>
                    <BoxView StyleClass="Separator" />
                    <Grid StyleClass="ListRow" ColumnDefinitions="*,Auto">
                        <Label Text="Disabled" VerticalOptions="Center" StyleClass="Secondary" />
                        <Switch Grid.Column="1" IsToggled="True" IsEnabled="False" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Checkboxes" Style="{StaticResource SectionHeader}" />
            <Border StyleClass="GroupedCell">
                <VerticalStackLayout>
                    <Grid StyleClass="ListRow" ColumnDefinitions="Auto,*">
                        <CheckBox IsChecked="True" VerticalOptions="Center" StyleClass="Leading" />
                        <Label Grid.Column="1" Text="Accept terms" VerticalOptions="Center" />
                    </Grid>
                    <BoxView StyleClass="Separator" />
                    <Grid StyleClass="ListRow" ColumnDefinitions="Auto,*">
                        <CheckBox VerticalOptions="Center" StyleClass="Leading" />
                        <Label Grid.Column="1" Text="Subscribe to newsletter" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Radio group" Style="{StaticResource SectionHeader}" />
            <Border StyleClass="GroupedCell">
                <VerticalStackLayout RadioButtonGroup.GroupName="appearance">
                    <RadioButton Content="Automatic" IsChecked="True" />
                    <BoxView StyleClass="Separator" />
                    <RadioButton Content="Light" />
                    <BoxView StyleClass="Separator" />
                    <RadioButton Content="Dark" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Slider" Style="{StaticResource SectionHeader}" />
            <VerticalStackLayout Padding="{StaticResource ContentMargin}" Spacing="12">
                <Slider Minimum="0" Maximum="100" Value="40" />
                <Slider Minimum="0" Maximum="100" Value="70" IsEnabled="False" />
            </VerticalStackLayout>

            <Label Text="Stepper" Style="{StaticResource SectionHeader}" />
            <Border StyleClass="GroupedCell">
                <Grid StyleClass="ListRow" ColumnDefinitions="*,Auto,Auto">
                    <Label Text="Quantity" VerticalOptions="Center" />
                    <Label Grid.Column="1" x:Name="StepperValue" Text="1" VerticalOptions="Center" StyleClass="Secondary" Margin="0,0,12,0" />
                    <Stepper Grid.Column="2" Minimum="0" Maximum="10" Value="1" Increment="1" VerticalOptions="Center" ValueChanged="OnStepperChanged" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

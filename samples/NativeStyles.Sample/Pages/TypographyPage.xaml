<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:NativeStyles.Sample.Pages"
             x:Class="NativeStyles.Sample.Pages.TypographyPage"
             x:DataType="pages:TypographyPage"
             Title="Typography"
             StyleClass="Grouped">
    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,0,0,24">

            <Label Text="Shared aliases" Style="{StaticResource SectionHeader}" />
            <Border StyleClass="Card" Margin="{StaticResource ContentMargin}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="TitleXL" Style="{StaticResource TitleXL}" />
                    <Label Text="TitleL" Style="{StaticResource TitleL}" />
                    <Label Text="TitleM" Style="{StaticResource TitleM}" />
                    <Label Text="TitleS" Style="{StaticResource TitleS}" />
                    <Label Text="Headline / BodyEmphasized" Style="{StaticResource Headline}" />
                    <Label Text="Body — the quick brown fox jumps over the lazy dog" Style="{StaticResource Body}" />
                    <Label Text="BodySecondary — supporting text" Style="{StaticResource BodySecondary}" />
                    <Label Text="Caption — metadata" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Platform scale" Style="{StaticResource SectionHeader}" />
            <Border StyleClass="Card" Margin="{StaticResource ContentMargin}">
                <VerticalStackLayout x:Name="ScaleHost" Spacing="8" />
            </Border>

            <Label Text="Colors (light / dark)" Style="{StaticResource SectionHeader}" />
            <Border StyleClass="Card" Margin="{StaticResource ContentMargin}">
                <VerticalStackLayout x:Name="ColorHost" Spacing="6" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

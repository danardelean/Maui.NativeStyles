<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
                    xmlns:native="clr-namespace:NativeStyles"
                    xmlns:local="clr-namespace:NativeStyles.Resources.iOS"
                    x:Class="NativeStyles.Resources.iOS.iOSStyles">

    <ResourceDictionary.MergedDictionaries>
        <local:iOSColors />
        <local:iOSTypography />
    </ResourceDictionary.MergedDictionaries>

    <!--
        iOS 26 implicit styles.
        Colors come from {native:SystemColor}: UIColor system colors resolved at runtime (Increased Contrast aware).
        Rule: never set FontFamily, never paint BackgroundColor on input controls, never override
        Switch/Slider/Stepper/ProgressBar/ActivityIndicator colors. The native handler defaults
        (compiled against the iOS 26 SDK) already render Liquid Glass and the system tint.
        Button appearance comes from the UIButtonConfiguration mapper in Platforms/iOS/NativeStyles.iOS.cs,
        driven by the NativeButton attached properties. The StyleClass styles below only set those properties,
        so StyleClass="Filled" and native:NativeButton.Kind="Filled" are equivalent.
    -->

    <!-- Text -->
    <Style TargetType="Label" BasedOn="{StaticResource Body}" />
    <Style TargetType="Label" Class="Secondary">
        <Setter Property="TextColor" Value="{native:SystemColor TextSecondary}" />
    </Style>
    <Style TargetType="Label" Class="Tertiary">
        <Setter Property="TextColor" Value="{native:SystemColor TextTertiary}" />
    </Style>
    <Style TargetType="Label" Class="Accent">
        <Setter Property="TextColor" Value="{native:SystemColor Accent}" />
    </Style>
    <Style TargetType="Label" Class="Semibold">
        <Setter Property="native:NativeText.Weight" Value="Semibold" />
    </Style>
    <Style TargetType="Span">
        <Setter Property="TextColor" Value="{native:SystemColor TextPrimary}" />
    </Style>

    <!-- Button: only metrics; colors/shape come from UIButtonConfiguration -->
    <Style TargetType="Button">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>
    <Style TargetType="Button" Class="Filled">
        <Setter Property="native:NativeButton.Kind" Value="Filled" />
    </Style>
    <Style TargetType="Button" Class="Tonal">
        <Setter Property="native:NativeButton.Kind" Value="Tonal" />
    </Style>
    <Style TargetType="Button" Class="Outlined">
        <Setter Property="native:NativeButton.Kind" Value="Outlined" />
    </Style>
    <Style TargetType="Button" Class="Text">
        <Setter Property="native:NativeButton.Kind" Value="Text" />
    </Style>
    <Style TargetType="Button" Class="Glass">
        <Setter Property="native:NativeButton.Kind" Value="Glass" />
    </Style>
    <Style TargetType="Button" Class="GlassProminent">
        <Setter Property="native:NativeButton.Kind" Value="GlassProminent" />
    </Style>
    <Style TargetType="Button" Class="Destructive">
        <Setter Property="native:NativeButton.IsDestructive" Value="True" />
    </Style>
    <Style TargetType="Button" Class="Small">
        <Setter Property="native:NativeButton.Size" Value="Small" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="MinimumHeightRequest" Value="34" />
    </Style>
    <Style TargetType="Button" Class="Large">
        <Setter Property="native:NativeButton.Size" Value="Large" />
        <Setter Property="Padding" Value="24,15" />
        <Setter Property="MinimumHeightRequest" Value="50" />
    </Style>
    <Style TargetType="ImageButton">
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.35" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Text input: UITextField keeps its native RoundedRect border (MAUI default) -->
    <Style TargetType="Entry">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{native:SystemColor TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{native:SystemColor Placeholder}" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>
    <Style TargetType="Entry" Class="Plain">
        <!-- Border removed by the Entry handler mapper; used inside grouped cells -->
        <Setter Property="native:NativeEntry.IsPlain" Value="True" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>
    <Style TargetType="Editor">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{native:SystemColor TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{native:SystemColor Placeholder}" />
        <Setter Property="AutoSize" Value="TextChanges" />
        <Setter Property="MinimumHeightRequest" Value="88" />
    </Style>
    <Style TargetType="SearchBar">
        <Setter Property="ios:SearchBar.SearchBarStyle" Value="Minimal" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{native:SystemColor TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{native:SystemColor Placeholder}" />
    </Style>

    <!-- Pickers: UITextField + UIPickerView/UIDatePicker input views (glass automatically) -->
    <Style TargetType="Picker">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{native:SystemColor TextPrimary}" />
        <Setter Property="TitleColor" Value="{native:SystemColor Placeholder}" />
        <Setter Property="ios:Picker.UpdateMode" Value="WhenFinished" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{native:SystemColor TextPrimary}" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>
    <Style TargetType="TimePicker">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{native:SystemColor TextPrimary}" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>

    <!-- Selection: Switch / Slider / Stepper intentionally have NO style (fully native) -->
    <Style TargetType="CheckBox">
        <!-- iOS has no checkbox; MAUI draws a circle with a checkmark. Tint it with the system accent. -->
        <Setter Property="Color" Value="{native:SystemColor Accent}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>
    <Style TargetType="RadioButton">
        <!-- iOS pattern: a list row with a checkmark on the trailing edge when selected -->
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{native:SystemColor TextPrimary}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="ControlTemplate">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto" Padding="16,0" MinimumHeightRequest="44" ColumnSpacing="12">
                    <Label Grid.Column="0"
                           Text="{TemplateBinding Content}"
                           FontSize="{TemplateBinding FontSize}"
                           TextColor="{TemplateBinding TextColor}"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="✓"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{native:SystemColor Accent}"
                           VerticalOptions="Center"
                           IsVisible="{TemplateBinding IsChecked}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor" Value="{native:SystemColor Separator}" />
        <Setter Property="SelectedIndicatorColor" Value="{native:SystemColor TextPrimary}" />
        <Setter Property="IndicatorSize" Value="8" />
    </Style>

    <!-- Feedback: ProgressBar / ActivityIndicator intentionally have NO style (system tint) -->

    <!-- Containers -->
    <Style TargetType="Border">
        <!-- Inset grouped section / card: secondarySystemGroupedBackground, 10pt continuous corners, no stroke -->
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Background" Value="{native:SystemColor CardBackground}" />
    </Style>
    <Style TargetType="Border" Class="Card">
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style TargetType="Border" Class="GroupedCell">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="16,0" />
    </Style>
    <Style TargetType="Border" Class="Outlined">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{native:SystemColor Separator}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Grouped list row (use as the root of a CollectionView ItemTemplate or inside GroupedCell) -->
    <Style TargetType="Grid" Class="ListRow">
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SystemGray5}, Dark={StaticResource SystemGray4Dark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style TargetType="BoxView" Class="Separator">
        <Setter Property="HeightRequest" Value="0.5" />
        <Setter Property="Color" Value="{native:SystemColor Separator}" />
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>
    <Style TargetType="Label" Class="Chevron">
        <!-- Disclosure indicator -->
        <Setter Property="Text" Value="›" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextColor" Value="{native:SystemColor TextTertiary}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{native:SystemColor PageBackground}" />
        <Setter Property="ios:Page.LargeTitleDisplay" Value="Always" />
    </Style>
    <Style TargetType="ContentPage" Class="Grouped" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{native:SystemColor GroupedBackground}" />
    </Style>
    <Style TargetType="ScrollView">
        <Setter Property="Padding" Value="0,0,0,16" />
    </Style>

    <!-- Shell / NavigationPage / TabbedPage: NO color setters. Bars are Liquid Glass when linked against SDK 26;
         setting TabBarBackgroundColor on iOS 26 paints an opaque slab behind the floating tab bar (dotnet/maui#37423). -->
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
    </Style>
    <Style TargetType="NavigationPage">
        <Setter Property="ios:NavigationPage.PrefersLargeTitles" Value="True" />
    </Style>

    <!-- GlassView: fully handled by GlassViewHandler on iOS -->
    <Style TargetType="native:GlassView">
        <Setter Property="Padding" Value="8" />
    </Style>

</ResourceDictionary>

<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:native="clr-namespace:NativeStyles"
                    xmlns:local="clr-namespace:NativeStyles.Resources.iOS"
                    x:Class="NativeStyles.Resources.iOS.iOSTypography">

    <ResourceDictionary.MergedDictionaries>
        <local:iOSColors />
    </ResourceDictionary.MergedDictionaries>

    <!--
        iOS Dynamic Type text styles at the default (Large) content size.
        Sizes/leading from Apple HIG > Typography; CharacterSpacing = SF Pro tracking table (pt).
        FontFamily is never set so the handler resolves the system font (SF Pro).
        Semibold (Headline, Title3) is applied by the iOS Label handler through native:NativeText.Weight.
    -->

    <Style x:Key="BaseText" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LabelColor}, Dark={StaticResource LabelColorDark}}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="LargeTitle" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0.40" />
        <Setter Property="LineHeight" Value="1.2" />
    </Style>
    <Style x:Key="Title1" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0.38" />
    </Style>
    <Style x:Key="Title2" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-0.26" />
    </Style>
    <Style x:Key="Title3" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="native:NativeText.Weight" Value="Semibold" />
        <Setter Property="CharacterSpacing" Value="-0.45" />
    </Style>
    <Style x:Key="Headline" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="native:NativeText.Weight" Value="Semibold" />
        <Setter Property="CharacterSpacing" Value="-0.43" />
    </Style>
    <Style x:Key="Body" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="CharacterSpacing" Value="-0.43" />
    </Style>
    <Style x:Key="Callout" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CharacterSpacing" Value="-0.31" />
    </Style>
    <Style x:Key="Subheadline" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CharacterSpacing" Value="-0.23" />
    </Style>
    <Style x:Key="Footnote" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CharacterSpacing" Value="-0.08" />
    </Style>
    <Style x:Key="Caption1" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="0" />
    </Style>
    <Style x:Key="Caption2" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="0.06" />
    </Style>

    <!-- Grouped table section header: Footnote, uppercase, secondary label -->
    <Style x:Key="SectionHeader" TargetType="Label" BasedOn="{StaticResource Footnote}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SecondaryLabelColor}, Dark={StaticResource SecondaryLabelColorDark}}" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="CharacterSpacing" Value="0.5" />
        <Setter Property="Margin" Value="16,16,16,6" />
    </Style>
    <Style x:Key="SectionFooter" TargetType="Label" BasedOn="{StaticResource Footnote}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SecondaryLabelColor}, Dark={StaticResource SecondaryLabelColorDark}}" />
        <Setter Property="Margin" Value="16,6,16,16" />
    </Style>

    <!-- Cross-platform aliases (same keys exist in MaterialTypography.xaml) -->
    <Style x:Key="TitleXL" TargetType="Label" BasedOn="{StaticResource LargeTitle}" />
    <Style x:Key="TitleL" TargetType="Label" BasedOn="{StaticResource Title1}" />
    <Style x:Key="TitleM" TargetType="Label" BasedOn="{StaticResource Title2}" />
    <Style x:Key="TitleS" TargetType="Label" BasedOn="{StaticResource Title3}" />
    <Style x:Key="BodyEmphasized" TargetType="Label" BasedOn="{StaticResource Headline}" />
    <Style x:Key="BodySecondary" TargetType="Label" BasedOn="{StaticResource Subheadline}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SecondaryLabelColor}, Dark={StaticResource SecondaryLabelColorDark}}" />
    </Style>
    <Style x:Key="Caption" TargetType="Label" BasedOn="{StaticResource Caption1}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SecondaryLabelColor}, Dark={StaticResource SecondaryLabelColorDark}}" />
    </Style>

</ResourceDictionary>

<Project Sdk="Microsoft.NET.Sdk">

	<!--
		xunit tests that run inside a MAUI app on the iOS simulator / Android emulator, with the real handlers and native
		views. Headless run (build, deploy, launch, collect a TRX) through DeviceRunners.Testing.Targets:
		  dotnet test tests/Maui.NativeStyles.DeviceTests -f net10.0-ios -p:DeviceRunnersDevice=<simulator UDID>
		  dotnet test tests/Maui.NativeStyles.DeviceTests -f net10.0-android -p:DeviceRunnersDevice=emulator-5554
		Launched normally (IDE, dotnet build -t:Run) it shows the DeviceRunners visual runner instead.
	-->

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>NativeStyles.DeviceTests</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<IsPackable>false</IsPackable>

		<!-- Same Android handlers as the sample: with Material 3 the input controls use MAUI's internal *Handler2 classes -->
		<UseMaterial3>true</UseMaterial3>

		<ApplicationTitle>NativeStyles Tests</ApplicationTitle>
		<ApplicationId>it.mahiz.nativestyles.devicetests</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

		<!-- The MAUI app has its own entry point: no generated test platform entry point -->
		<GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
		<!-- TRX, event stream and device log of `dotnet test` (git-ignored); override with results-directory -->
		<TestResultsDirectory>$(MSBuildProjectDirectory)/TestResults/</TestResultsDirectory>
		<!-- Android deploys through the platform's Install target: send it to the device the runner launches the app on -->
		<AdbTarget Condition="'$(AdbTarget)' == '' and '$(DeviceRunnersDevice)' != '' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">-s $(DeviceRunnersDevice)</AdbTarget>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<!-- DeviceRunners.VisualRunners.Maui depends on an older Compatibility package: keep it on the pinned MAUI version -->
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
		<PackageReference Include="DeviceRunners.VisualRunners.Maui" Version="0.1.0-preview.12" />
		<PackageReference Include="DeviceRunners.VisualRunners.Xunit" Version="0.1.0-preview.12" />
		<PackageReference Include="DeviceRunners.Testing.Targets" Version="0.1.0-preview.12" />
		<PackageReference Include="xunit" Version="2.9.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Maui.NativeStyles\Maui.NativeStyles.csproj" />
	</ItemGroup>

	<!--
		Without a device DeviceRunners picks whatever simulator or emulator is running, and `dotnet test` on the solution
		would deploy to it: require an explicit target instead.
	-->
	<Target Name="RequireDeviceRunnersDevice" BeforeTargets="_DeviceRunnersMarkTestRun">
		<Error Condition="'$(DeviceRunnersDevice)' == ''"
			Text="Device tests need a target: dotnet test tests/Maui.NativeStyles.DeviceTests -f net10.0-ios|net10.0-android -p:DeviceRunnersDevice=&lt;simulator UDID or emulator serial&gt;. Unit tests: dotnet test tests/Maui.NativeStyles.Tests." />
	</Target>

</Project>
